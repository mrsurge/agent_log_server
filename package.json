{
  "name": "als-rs-frontend",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.2.1",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "lint:types": "eslint --max-warnings=0 \"rust/crates/als-server/src/static/**/*.ts\"",
    "test:conversation-modal": "node --test tests/conversation_modal.test.mjs",
    "test:mention-picker": "node --test tests/mention_picker.test.mjs",
    "test:transcript-url": "node --test tests/transcript_stream_url.test.mjs",
    "typecheck": "tsc --noEmit && npm run lint:types --silent"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@msgpack/msgpack": "^3.1.3",
    "highlight.js": "^11.11.1",
    "highlightjs-diff": "^1.0.0",
    "markdown-it": "^14.1.1",
    "reconnecting-websocket": "^4.4.0",
    "socket.io-client": "^4.7.5",
    "socket.io-msgpack-parser": "^3.0.2",
    "streaming-markdown": "^0.2.15",
    "tributejs": "^5.1.3"
  }
}
