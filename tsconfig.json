{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ES2020"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "rust/crates/als-server/src/static/**/*.js",
    "rust/crates/als-server/src/static/**/*.ts"
  ],
  "exclude": [
    "rust/crates/als-server/src/static/dist/**",
    "rust/crates/als-server/src/static/vendor/**"
  ]
}
