{
  "id": "copilot-sdk",
  "name": "GitHub Copilot",
  "version": "1.0.0",
  "type": "copilot_sdk",
  "description": "GitHub Copilot CLI agent via the Python SDK",

  "agent": {
    "command": "copilot",
    "args": [],
    "env": {},
    "eagerSessionInit": true
  },

  "capabilities": {
    "sessionResume": true,
    "streaming": true,
    "modelListing": true,
    "permissionHandling": true,
    "hooks": true,
    "hasPlan": true,
    "hasTodo": true,
    "hasPlanModes": true
  },

  "dependencies": {
    "has_check": true,
    "has_install": true
  },

  "model": {
    "name": "gpt-5.1-codex",
    "provider": "github-copilot"
  },

  "ui": {
    "icon": "copilot.svg",
    "color": "#6e40c9",
    "semanticShellRibbon": {
      "quoteParsing": false
    },
    "toolRenderPolicy": {
      "default": {
        "args": "plain",
        "result": "plain"
      },
      "rules": [
        {
          "tool": "Agent-log write",
          "requestFields": {
            "Message": "markdown"
          }
        },
        {
          "tool": "sql",
          "requestFields": {
            "description": "plain",
            "query": "plain"
          },
          "response": "markdown"
        },
        {
          "server": "agent-pty-blocks",
          "toolPrefix": "agent_log_",
          "response": "markdown"
        },
        {
          "server": "agent-pty-blocks",
          "tool": "kb_write",
          "requestFields": {
            "content": "markdown"
          }
        },
        {
          "server": "agent-pty-blocks",
          "tool": "kb_update",
          "requestFields": {
            "content": "markdown"
          }
        },
        {
          "server": "agent-pty-blocks",
          "toolPrefix": "kb_",
          "response": "markdown"
        },
        {
          "server": "te2-mcp",
          "tool": "te2_console_eval",
          "requestFields": {
            "target_worker_id": "plain",
            "code": {
              "kind": "hljs",
              "language": "javascript"
            }
          },
          "responseFields": {
            "workerId": "plain",
            "reqId": "plain",
            "ok": "plain",
            "value": {
              "kind": "hljs",
              "language": "json"
            }
          }
        }
      ]
    },
    "requestCards": [
      {
        "id": "copilot-permission-request",
        "module": "ui/request_cards/copilot_request_card.js",
        "export": "renderRequestCard",
        "matches": [
          {
            "requestMethod": "copilot/permission/request"
          }
        ]
      },
      {
        "id": "copilot-user-input-request",
        "module": "ui/request_cards/copilot_request_card.js",
        "export": "renderRequestCard",
        "matches": [
          {
            "requestMethod": "copilot/user_input/request"
          }
        ]
      }
    ]
  }
}
