{
  "version": "1",
  "description": "Settings schema for GitHub Copilot SDK extension",
  "fields": [
    {
      "id": "cwd",
      "type": "path",
      "label": "Working Directory",
      "placeholder": "~/project",
      "default": "~",
      "required": true,
      "browse": true
    },
    {
      "id": "session",
      "type": "session_picker",
      "label": "Session",
      "placeholder": "(new session) or type/paste session ID",
      "source": "/api/extensions/copilot-sdk/sessions",
      "resume_endpoint": "/api/extensions/copilot-sdk/sessions/resume",
      "picker_sort": {
        "param": "sort",
        "default": "updated_at",
        "options": [
          { "value": "updated_at", "label": "MRU" },
          { "value": "created_at", "label": "Created" }
        ]
      }
    },
    {
      "id": "model",
      "type": "select",
      "label": "Model",
      "options": [],
      "dynamic_source": "/api/extensions/copilot-sdk/models",
      "default": ""
    },
    {
      "id": "reasoning_effort",
      "type": "select",
      "label": "Reasoning Effort",
      "options": [],
      "dynamic_source": "/api/extensions/copilot-sdk/models",
      "dynamic_options_from": {
        "source_field": "model",
        "match_path": "id",
        "options_path": [
          "supported_reasoning_efforts",
          "supportedReasoningEfforts",
          "raw.supported_reasoning_efforts",
          "raw.supportedReasoningEfforts"
        ],
        "option_value_path": "value",
        "option_label_path": "label",
        "default_path": [
          "default_reasoning_effort",
          "defaultReasoningEffort",
          "raw.default_reasoning_effort",
          "raw.defaultReasoningEffort"
        ],
        "missing_source_placeholder": "Select model first",
        "empty_placeholder": "Not supported by selected model"
      },
      "default": ""
    },
    {
      "id": "developer_instructions",
      "type": "textarea",
      "label": "Developer Instructions",
      "placeholder": "Additional runtime instructions appended to the Copilot SDK system prompt",
      "rows": 6,
      "default": ""
    },
    {
      "id": "mcp_servers",
      "type": "json",
      "label": "MCP Servers",
      "placeholder": "{\"my-server\": {\"command\": [\"uvx\", \"my-mcp-server\"]}}",
      "rows": 8,
      "json_kind": "object",
      "default": ""
    },
    {
      "id": "debug_trace",
      "type": "checkbox",
      "label": "Internal Debug Trace",
      "default": false
    },
    {
      "id": "approval_policy",
      "type": "select",
      "label": "Approval Policy",
      "options": [],
      "dynamic_source": "/api/appserver/runtime_options",
      "dynamic_options_key": "approval",
      "default": "suggest",
      "semantic": {
        "role": "approval_policy",
        "runtime_key": "approval",
        "label": "Approval"
      }
    },
    {
      "id": "sandbox_policy",
      "type": "select",
      "label": "Directory Trust",
      "options": [],
      "dynamic_source": "/api/appserver/runtime_options",
      "dynamic_options_key": "sandbox",
      "default": "cwd-only",
      "runtime_option": {
        "kind": "sandbox"
      }
    },
    {
      "id": "web_policy",
      "type": "select",
      "label": "Web Access",
      "options": [],
      "dynamic_source": "/api/appserver/runtime_options",
      "dynamic_options_key": "web",
      "default": "deny",
      "runtime_option": {
        "kind": "web"
      }
    },
    {
      "id": "mode",
      "type": "select",
      "label": "Mode",
      "options": [],
      "dynamic_source": "/api/appserver/runtime_options",
      "dynamic_options_key": "mode",
      "default": "interactive",
      "semantic": {
        "role": "mode",
        "runtime_key": "mode",
        "label": "Mode",
        "accents": {
          "plan": "ok",
          "interactive": "warn",
          "autopilot": "warn"
        }
      }
    }
  ]
}
