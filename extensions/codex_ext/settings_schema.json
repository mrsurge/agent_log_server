{
  "version": "1",
  "description": "Settings schema for the Codex app-server extension",
  "fields": [
    {
      "id": "cwd",
      "type": "path",
      "label": "Working Directory",
      "placeholder": "~/project",
      "default": "~",
      "required": true,
      "browse": true
    },
    {
      "id": "session",
      "type": "session_picker",
      "label": "Session",
      "placeholder": "(new session) or type/paste session ID",
      "source": "/api/extensions/codex-ext/sessions",
      "resume_endpoint": "/api/extensions/codex-ext/sessions/resume",
      "picker_sort": {
        "param": "sort",
        "default": "updated_at",
        "options": [
          { "value": "updated_at", "label": "MRU" },
          { "value": "created_at", "label": "Created" }
        ]
      }
    },
    {
      "id": "model",
      "type": "select",
      "label": "Model",
      "options": [],
      "dynamic_source": "/api/extensions/codex-ext/models",
      "placeholder": "Use server default",
      "default": ""
    },
    {
      "id": "high_context_400k",
      "type": "checkbox",
      "label": "400k Context",
      "default": false,
      "model_gate": {
        "family": "gpt",
        "min_major": 5,
        "min_minor": 4,
        "label": "GPT-5.4 or newer"
      }
    },
    {
      "id": "reasoning_effort",
      "type": "select",
      "label": "Reasoning Effort",
      "options": [],
      "dynamic_source": "/api/extensions/codex-ext/models",
      "dynamic_options_from": {
        "source_field": "model",
        "match_path": "id",
        "options_path": [
          "supportedReasoningEfforts",
          "supported_reasoning_efforts",
          "raw.supportedReasoningEfforts",
          "raw.supported_reasoning_efforts"
        ],
        "option_value_path": "reasoningEffort",
        "option_label_path": "reasoningEffort",
        "default_path": [
          "defaultReasoningEffort",
          "default_reasoning_effort",
          "raw.defaultReasoningEffort",
          "raw.default_reasoning_effort"
        ],
        "missing_source_placeholder": "Select model first",
        "empty_placeholder": "Not supported by selected model"
      },
      "placeholder": "Select model first",
      "default": "",
      "value_keys": ["effort"]
    },
    {
      "id": "summary",
      "type": "select",
      "label": "Reasoning Summary",
      "options": [
        { "value": "auto", "label": "auto" },
        { "value": "concise", "label": "concise" },
        { "value": "detailed", "label": "detailed" },
        { "value": "none", "label": "none" }
      ],
      "placeholder": "Use model default",
      "default": ""
    },
    {
      "id": "approvalPolicy",
      "type": "select",
      "label": "Approval Policy",
      "options": [],
      "dynamic_source": "/api/appserver/runtime_options",
      "dynamic_options_key": "approval",
      "placeholder": "Use server default",
      "default": "",
      "semantic": {
        "role": "approval_policy",
        "runtime_key": "approval",
        "label": "Approval"
      }
    },
    {
      "id": "sandboxPolicy",
      "type": "select",
      "label": "Sandbox Policy",
      "options": [],
      "dynamic_source": "/api/appserver/runtime_options",
      "dynamic_options_key": "sandbox",
      "placeholder": "Use server default",
      "default": ""
    },
    {
      "id": "mode",
      "type": "select",
      "label": "Mode",
      "options": [],
      "dynamic_source": "/api/appserver/runtime_options",
      "dynamic_options_key": "mode",
      "placeholder": "Use runtime default",
      "default": "",
      "semantic": {
        "role": "mode",
        "runtime_key": "mode",
        "label": "Mode",
        "accents": {
          "plan": "ok",
          "default": "warn"
        }
      }
    },
    {
      "id": "developer_instructions",
      "type": "textarea",
      "label": "Developer Instructions",
      "placeholder": "Additional runtime instructions appended to the Codex thread configuration",
      "rows": 6,
      "default": ""
    }
  ]
}
